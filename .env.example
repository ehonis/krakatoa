# Krakatoa server environment. Every variable is optional; the defaults are shown.
# Most of these can also be set in the browser, under Settings. A variable set
# here always wins and shows as locked in Settings.
#
# The server does not load this file by itself. Either export the variables,
# point a systemd unit at it (EnvironmentFile=), use docker compose (which reads
# .env), or run:
#   node --env-file=.env server/server.js

# --- Sign-in ---------------------------------------------------------------------
# builtin (default): one owner account, created from the setup link the server
# prints on first run. proxy: no sign-in here, for an install already behind an
# authenticating proxy (Cloudflare Access, oauth2-proxy, ...).
# KRAKATOA_AUTH=builtin
# The address people reach the server at. Used in the setup link, and https here
# marks the session cookie Secure.
# KRAKATOA_PUBLIC_URL=https://food.example.com
# Bearer token for MCP clients and scripts (Authorization: Bearer <token>).
# Settings can generate one instead. A token cannot change Settings.
# KRAKATOA_API_TOKEN=
# Believe X-Forwarded-For / CF-Connecting-IP for the sign-in lockout:
# 1 always, 0 never. Unset: only when the connection comes from this machine.
# KRAKATOA_TRUST_PROXY=

# --- HTTP ----------------------------------------------------------------------
# KRAKATOA_PORT=8101
# KRAKATOA_BIND=0.0.0.0
# Where the log lives (gitignored) and where the built app is served from.
# KRAKATOA_DATA_DIR=./data
# KRAKATOA_DIST_DIR=./dist

# --- Food databases --------------------------------------------------------------
# USDA FoodData Central key (free: https://fdc.nal.usda.gov/api-key-signup.html).
# Without one the server uses DEMO_KEY, about 30 requests an hour.
# Can also be set as "usdaKey" in data/config.json.
KRAKATOA_USDA_KEY=
# Open Food Facts needs no key. These only change which instance and shelf it asks.
# KRAKATOA_OFF_UA=Krakatoa/0.1 (self-hosted personal tracker)
# KRAKATOA_OFF_BASE=https://world.openfoodfacts.org
# KRAKATOA_OFF_SEARCH=https://search.openfoodfacts.org
# KRAKATOA_OFF_COUNTRY=us
# KRAKATOA_OFF_COUNTRY_NAME=united-states
# KRAKATOA_LOOKUP_TIMEOUT_MS=8000
# Nutritionix (optional, business accounts only). Also settable in data/config.json.
KRAKATOA_NUTRITIONIX_ID=
KRAKATOA_NUTRITIONIX_KEY=

# --- Label reader and Ask AI (headless Claude Code CLI) --------------------------
# Path to the `claude` binary. Default: $HOME/.local/bin/claude, else PATH.
# CLAUDE_BIN=
# Instead of signing the CLI in, give it an API key. It inherits this env.
# ANTHROPIC_API_KEY=
# KRAKATOA_LABEL_MODEL=claude-sonnet-5
# KRAKATOA_LABEL_TIMEOUT_MS=90000
# KRAKATOA_ASK_MODEL=claude-sonnet-5
# KRAKATOA_ASK_EFFORT=medium

# --- WHOOP burn, read from Bushido (optional, off by default) --------------------
# Krakatoa holds no WHOOP credentials; Bushido holds the grant and Krakatoa asks
# it (POST /api/whoop/owner). Off unless both are set, here or in Settings.
# BUSHIDO_API_URL=http://127.0.0.1:8099
# BUSHIDO_API_TOKEN=
# KRAKATOA_WHOOP_STALE_MS=1200000
# KRAKATOA_WHOOP_DAYS=30

# --- Totem bridge: habit push (optional, off by default) -------------------------
# Off unless KRAKATOA_TOTEM=1, KRAKATOA_TOTEM_URL is set, or Settings turns it on.
# KRAKATOA_TOTEM=0
# KRAKATOA_TOTEM_URL=http://127.0.0.1:8787
# The bridge secret, given directly...
BRIDGE_SECRET=
# ...or read from the BRIDGE_SECRET= line of Totem's own .env.
# No default. (An install upgraded from before Settings records where it read it.)
# KRAKATOA_TOTEM_ENV=
# KRAKATOA_TOTEM_HABIT=krakatoa

# --- Digest file (optional, off by default) --------------------------------------
# Write data/digest.json, a small summary of the last two weeks, after every
# change, for other tools on the same machine to read.
# KRAKATOA_DIGEST_FILE=0

# --- Build time (read by Vite from app/.env.local or the build's environment) ---
# Old hostnames that should hand their offline log over and move to a new one,
# for when the app changes address. Empty: nothing moves.
# VITE_KRAKATOA_LEGACY_HOSTS=old.example.com=new.example.com
