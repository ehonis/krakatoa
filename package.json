{
  "name": "krakatoa",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted food log: barcode scanning, USDA basics, chain menus, Ask AI.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehonis/krakatoa.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --dir app install --frozen-lockfile",
    "build": "pnpm --dir app run build",
    "build:menus": "node scripts/restaurants.build.mjs",
    "build:basics": "node scripts/basics.build.mjs",
    "start": "pnpm run build && node server/server.js",
    "serve": "node server/server.js",
    "dev": "pnpm --dir app run dev",
    "test": "pnpm --dir app test && node server/nutritionix.test.js"
  }
}
